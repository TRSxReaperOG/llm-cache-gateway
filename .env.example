# --- Gateway config (read by the running service) ---

# "voyage" (default) or "local". "local" uses the bundled sentence-transformers
# fallback and needs no API key, at the cost of lower measured match quality
# (see eval/EMBEDDING_TRADEOFFS.md).
EMBEDDING_BACKEND=voyage

# Required only when EMBEDDING_BACKEND=voyage.
VOYAGE_API_KEY=

# Qdrant connection. Leave as-is for local dev against `docker compose up`
# (the gateway container overrides this to the in-network qdrant hostname
# automatically). Not needed when running the test suite — tests use Qdrant's
# :memory: mode instead.
QDRANT_URL=http://localhost:6333

# How long a cached entry stays eligible to be served before TTL eviction, in
# seconds. Default: 24h.
TTL_SECONDS=86400

# Max cache entries before the oldest (by last access) are evicted.
MAX_CACHE_SIZE=10000

# How many recent messages (not just the latest one) feed the embedding used
# for cache lookup, so multi-turn follow-ups don't collide across unrelated
# conversations. See src/llm_cache_gateway/adapters/base.py.
CONTEXT_MESSAGES=4


# --- NOT gateway config ---
#
# Provider API keys (Groq/Anthropic/Gemini/Cohere/OpenAI/Mistral/Together) are
# never read from this file by the running gateway — by design, each request
# carries its own key in its Authorization header, and the gateway forwards it
# upstream without ever persisting it (see Phase 1 of the project notes).
#
# The variables below are only used by the standalone scripts in eval/ and
# benchmark/ for their own testing against the real provider APIs. The gateway
# itself does not need them to run.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
